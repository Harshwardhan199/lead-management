		{
			"name": "Auth & User API",
			"item": [
				{
					"name": "1. Public Register Member User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.accessToken) {",
									"        pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"        console.log('Registered access token saved');",
									"    }",
									"    if (jsonData.data && jsonData.data.user && jsonData.data.user._id) {",
									"        pm.collectionVariables.set('memberUserId', jsonData.data.user._id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Jane Member\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Public registration - always creates a Member account regardless of client input"
					},
					"response": []
				},
